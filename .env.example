# docker-compose.yml bu dosyayı repo kökünde ".env" adıyla otomatik okur ve
# backend/worker/beat servislerine geçirir. Kopyalayıp değerleri doldurun:
#   cp .env.example .env

# LLM sağlayıcısı: "auto" (öncelik: anthropic > gemini > groq) | "anthropic" | "gemini" | "groq"
LLM_PROVIDER=auto

# En az birini doldurun
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Transactional email: use a sender address verified with your SMTP provider.
# No real email is sent until SMTP_HOST and SMTP_FROM_EMAIL are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Veyra
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# Must match the URL users open; use your public HTTPS URL when deployed.
FRONTEND_ORIGIN=http://localhost:3006
