# App
ENVIRONMENT=development
DEBUG=true

# Database (Docker Compose içinde host: postgres)
DATABASE_URL=postgresql+psycopg://cvagent:cvagent@localhost:5432/cvagent

# Redis / Celery (Docker Compose içinde host: redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM sağlayıcısı: "auto" (öncelik: anthropic > gemini > groq) | "anthropic" | "gemini" | "groq"
LLM_PROVIDER=auto

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.8-flash

# Groq (https://console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Storage (local | s3)
STORAGE_BACKEND=local
STORAGE_DIR=uploads
MAX_UPLOAD_MB=10

# CORS
FRONTEND_ORIGIN=http://localhost:3006

# Transactional email: use a sender address verified with your SMTP provider.
# No real email is sent until SMTP_HOST and SMTP_FROM_EMAIL are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Veyra
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
